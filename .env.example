# ---- Square API credentials ----
# Get these from https://developer.squareup.com/apps  (your app > Credentials)
# Use SANDBOX values while testing, PRODUCTION values when you go live.
SQUARE_ACCESS_TOKEN=replace_with_your_square_access_token
SQUARE_LOCATION_ID=replace_with_your_square_location_id

# "sandbox" for testing, "production" when live
SQUARE_ENV=sandbox

# Public base URL of your deployed site (used for the post-payment redirect)
SITE_URL=http://localhost:3000

# Port the server listens on
PORT=3000
